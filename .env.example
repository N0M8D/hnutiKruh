# Ecomail API klíč pro newsletter
ECOMAIL_API_KEY="your-ecomail-api-key"

# Připojení k MariaDB/MySQL (používá se Prisma)
DATABASE_URL="mysql://user:password@host:port/database"

# NocoDB API Token
PUBLIC_NOCODB_TOKEN=your_nocodb_api_token_here

# Public API Url
PUBLIC_API_URL=https://your-production-api-url.com

# Fio bankovní API tokeny - token je vázaný na 1 konkrétní účet,
# generuje se v internetovém bankovnictví. Klíče musí odpovídat
# src/config/fioAccounts.ts.
FIO_TOKEN_DARY="your_fio_token_for_donations_account"
FIO_TOKEN_SENAT2026="your_fio_token_for_senat_2026_election_account"

# Secret pro ochranu /api/fio-sync. Vercel Cron ho posílá automaticky jako
# "Authorization: Bearer <CRON_SECRET>", pokud proměnnou se stejným jménem
# nastavíte v nastavení Vercel projektu. Stejný secret použijte i pro
# ruční/cron volání z VPS.
CRON_SECRET="generate_a_random_secret_string"